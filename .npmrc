; This is a Gatsby v2 (2021) project. Its plugins declare npm-6-era peer deps
; (e.g. gatsby-plugin-sass -> node-sass), which npm 7+ tries to auto-install.
; We use dart-sass (the `sass` package) via gatsby-plugin-sass's `implementation`
; option instead, so the node-sass peer is intentionally left uninstalled.
legacy-peer-deps=true
